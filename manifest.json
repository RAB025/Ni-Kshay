{
"update_url": "https://clients2.google.com/service/update2/crx",

    "name": "Ni-Kshay Automation",
    "description": "Nikshay Portal Data Entry",
    "version": "2.2.0",
    "version_name": "V2.2.0",
    "manifest_version": 3,
    "content_scripts": [
        {
            "matches": [
                "https://nikshay.in/Dashboard/NewEnrollment/*"
            ],
            "js": [
                "script/content.js"
            ]
        },
        {
            "matches": [
                "https://nikshay.in/Dashboard/Diagnostics/*"
            ],
            "js": [
                "script/content_x_ray.js"
            ]
        },
        {
            "matches": [
                "https://nikshay.in/*"
            ],
            "js": [
                "script/content_trunat.js"
            ]
        }
    ],
    "icons": {
        "16": "Assets/16.png",
        "48": "Assets/48.png",
        "128": "Assets/128.png"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "options_ui": {
        "page": "option.html",
        "open_in_tab": true
    },
    "background": {
        "service_worker": "script/background.js"
    },
    "host_permissions": [
        "*://*.nikshay.in/*"
    ],
    "permissions": [
        "unlimitedStorage",
        "identity",
        "storage",
        "identity.email"
    ]
}