<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <!-- Portal Top Control Bar (shown on Nikshay Site tab) -->
    <LinearLayout
        android:id="@+id/portalToolbar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@color/surface_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnPortalBack"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="38dp"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="◀"
            android:textColor="@color/limegreen"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnPortalReload"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="38dp"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="↻"
            android:textColor="@color/limegreen"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvPortalStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Enroll: 0/0"
            android:textColor="@color/limegreen"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchPortalAuto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto"
            android:textColor="@color/white"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnDesktopMode"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minWidth="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="PC"
            android:textColor="@color/lime"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnToolbarLogs"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minWidth="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="Logs"
            android:textColor="@color/limegreen"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/lime"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/managerWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <WebView
            android:id="@+id/portalWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </FrameLayout>

    <!-- Bottom Tab Switcher -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/surface_dark"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/tabManager"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:backgroundTint="@color/limegreen"
            android:text="@string/tab_automation"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tabPortal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:backgroundTint="@color/border_dark"
            android:text="@string/tab_portal"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tabLogs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:backgroundTint="@color/border_dark"
            android:minWidth="72dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Logs 📋"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
